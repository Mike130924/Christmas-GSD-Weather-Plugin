<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries><package android:name="com.spocky.projengmenu" /></queries>
    <application android:allowBackup="true" android:label="@string/app_name" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".SettingsActivity" android:exported="true" />
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />
        <provider android:name=".provider.WallpaperImageProvider" android:authorities="${applicationId}.wallpaperimages" android:exported="true" android:grantUriPermissions="true" />
        <service android:name=".WeatherWallpaperService" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="tv.projectivy.plugin.WALLPAPER_PROVIDER" /></intent-filter>
            <meta-data android:name="apiVersion" android:value="1" />
            <meta-data android:name="uuid" android:value="@string/plugin_uuid" />
            <meta-data android:name="name" android:value="@string/app_name" />
            <meta-data android:name="settingsActivity" android:value=".SettingsActivity" />
            <meta-data android:name="itemsCacheDurationMillis" android:value="@integer/items_cache_duration_millis" />
            <meta-data android:name="updateMode" android:value="1" />
        </service>
    </application>
</manifest>
